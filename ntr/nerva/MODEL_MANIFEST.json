    "nuclear_data_preflight": true,
    "transport_provenance_bundle": true,
    "repeated_cell_instance_tallies": true,
    "fuel_element_integrated_power": true,
    "coolant_channel_instance_tallies": 19,
    "tie_component_instance_tallies": true,
    "direct_hydrogen_heating": {
      "fuel_channels": true,
      "tie_supply": true,
      "tie_return": true
    },
    "material_energy_matrix": true,
    "particle_heating_split_when_photon_transport_enabled": true,
    "stochastic_volume_calculations": true,
    "optional_tally_relative_error_trigger": true,
    "nuclear_data_temperature_audit": true,
    "fuel_element_axial_instance_tallies": true,
    "coolant_channel_axial_instance_tallies": true,
    "tie_component_axial_instance_tallies": true,
    "tie_supply_hydrogen_axial_instance_tallies": true,
    "tie_return_hydrogen_axial_instance_tallies": true,
    "fuel_channel_sector_integrated_tallies": true,
    "fuel_channel_sector_axial_tallies": true
  },
  "geometry": {
    "fuel_element": {
      "status": "public NERVA-derived dimensions",
      "flat_to_flat_cm": 1.905,
      "active_length_cm": 132,
      "coolant_channels": 19,
      "coolant_bore_diameter_cm": 0.2565,
      "coolant_bore_pitch_cm": 0.40894,
      "zrc_coating_thickness_cm": 0.005
    },
    "tie_tube": {
      "status": "public NERVA-derived dimensions with simplified material definitions",
      "central_supply_and_annular_return": true
    },
    "core_pattern": {
      "status": "representative SNRE-style mixed fuel/tie lattice",
      "historical_element_map_reproduced": false
    },
    "periphery": {
      "partial_filler": "homogenized graphite surrogate",
      "reflector": "beryllium",
      "control_drums": 12,
      "control_drum_dimensions": "engineering surrogate",
      "pressure_vessel": "aluminum-alloy surrogate"
    },
    "fuel_matrix_scoring_partition": {
      "implemented": true,
      "sectors_per_element": 19,
      "method": "nearest-channel Voronoi partition",
      "material_change": false,
      "internal_boundary_type": "transmission",
      "purpose": "channel-associated solid-heating scoring"
    }
  },
  "thermal_hydraulics": {
    "fuel_channel": {
      "implemented": true,
      "dimensionality": "1-D",
      "pressure_loss": "Darcy-Weisbach",
      "heat_transfer": "Dittus-Boelter / laminar fallback",
      "default_hydrogen": "constant-property ideal-gas surrogate",
      "optional_hydrogen": "CoolProp real-fluid state properties"
    },
    "tie_tube": {
      "implemented": true,
      "flow_topology": "central supply / annular return counterflow",
      "default_heat_split": "wetted-perimeter weighting",
      "turn_loss_model": false
    },
    "fuel_solid_temperature": {
      "implemented": true,
      "model": "1-D ZrC conduction plus half-ligament screening estimate",
      "full_2d_or_3d_conduction": false
    },
    "element_channel_reconstruction": {
      "implemented": true,
      "fuel_element_integrated_power_source": "OpenMC Distribcell tally",
      "channels_per_element": 19,
      "direct_hydrogen_heating_source": "OpenMC channel-instance heating-local tally",
      "element_specific_axial_shape": true,
      "axial_reconstruction": "direct OpenMC Distribcell x axial-mesh shapes when present; global axial shape only for legacy-statepoint fallback",
      "solid_wall_power_within_element": "direct OpenMC fuel-sector integrated and axial heating for current statepoints; equal 1/19 split only for legacy fallback",
      "fuel_sector_thermal_assignment": "nearest-channel Voronoi scoring sector heat is assigned to the associated coolant channel"
    },
    "direct_nuclear_coolant_heating": {
      "fuel_channels": true,
      "tie_supply_and_return": true,
      "treatment": "adds directly to bulk enthalpy; excluded from wall heat flux"
    },
    "tie_instance_resolution": {
      "implemented": true,
      "solid_axial_source": "sum of OpenMC tie-component Distribcell x axial-mesh heating-local tallies",
      "supply_hydrogen_axial_source": "OpenMC tie-supply Distribcell x axial-mesh heating-local tally",
      "return_hydrogen_axial_source": "OpenMC tie-return Distribcell x axial-mesh heating-local tally",
      "normalization": "instance fields renormalized to global OpenMC mesh totals for energy closure",
      "flow_distribution": "equal by default; optional common-pressure-drop balancing across tie instances",
      "representative_average_solver_retained": true
    },
    "parallel_flow_balancing": {
      "implemented": true,
      "default_enabled": false,
      "branches": [
        "all resolved fuel coolant channels",
        "all resolved tie-tube counterflow branches"
      ],
      "total_flow_constraint": "fixed user-supplied total mass flow",
      "branch_condition": "iterates toward common pressure drop",
      "update_model": "iteration-local effective quadratic resistance DeltaP/mdot^2",
      "relaxation_default": 0.5,
      "tolerance_default": 0.001,
      "maximum_iterations_default": 6,
      "caveat": "screening network balance; does not model manifolds, plenums, pumps, or crossflow"
    }
  },
  "software_validation": {
