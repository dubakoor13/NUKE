    "historical_criticality_calibration": false,
    "transport_with_production_nuclear_data_validated": false,
    "implemented_tallies": [
      "3-D flux",
      "3-D absorption",
      "3-D fission",
      "3-D nu-fission",
      "3-D heating",
      "3-D heating-local",
      "3-D fuel-only heating-local/fission/nu-fission",
      "3-D tie-solid heating-local/absorption",
      "material-resolved flux/absorption/fission/nu-fission/heating/heating-local",
      "fuel energy spectrum",
      "hydrogen energy spectrum and heating",
      "fine axial flux/fission/nu-fission/heating-local",
      "vacuum-boundary current"
    ],
    "photon_transport_optional": true,
    "source_entropy_mesh": true,
    "material_resolved_transport": true,
    "energy_spectra": [
      "fuel",
      "hydrogen"
    ],
    "axial_transport_mesh": true,
    "vacuum_boundary_current": true,
