    "parallel_flow_update_math": true,
    "balanced_fuel_channel_end_to_end": true,
    "balanced_tie_instance_end_to_end": true,
    "parallel_mass_flow_closure": true
  },
  "interpretation_rule": "Do not treat keff, control worth, temperatures, thrust, or performance as historical NERVA predictions until explicitly benchmarked. Fuel-element, channel-associated fuel-sector, coolant-channel, and tie-tube integrated/axial heating shapes are OpenMC tally outputs for current statepoints. Fuel-sector-to-channel heat assignment remains an engineering thermal partition. Parallel branch flow is equal by default or can be redistributed with the optional common-pressure-drop screening balance; manifolds/plenums/pump coupling are not modeled.",
  "results": {
